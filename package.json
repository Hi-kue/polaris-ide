{
  "name": "postfix-site",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "devDependencies": {
    "@biomejs/biome": "^2.2.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.3"
  },
  "scripts": {
    "prepare": "husky",
    "biome:lint": "pnpm exec biome lint --write . --no-errors-on-unmatched --files-ignore-unknown=true",
    "biome:format": "pnpm exec biome format --write . --no-errors-on-unmatched --files-ignore-unknown=true",
    "biome:check": "pnpm exec biome check --write . --no-errors-on-unmatched --files-ignore-unknown=true"
  }
}
